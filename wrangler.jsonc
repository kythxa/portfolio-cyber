{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-cyber",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio_cyber_db",
			"database_id": "99c7abd5-d1d5-45a3-a470-11ff3945425b"
		}
	]
}